# Copy to .env.local and fill in. Never commit .env.local.
# Orbit shares Kept's Supabase project, so these are the same values as Kept's.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where Orbit is reached (production), for Google sign-in links. Leave empty in dev.
SITE_URL=
